# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...   # the *anon* JWT
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=ostazna.com

# Server-only — NEVER ship to the client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...        # the *service_role* JWT (different from anon!)
SUPABASE_DB_URL=postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (welcome + reset). Optional in dev — no-op without it.
RESEND_API_KEY=
RESEND_FROM=Ostazna <hello@ostazna.com>

# Admin tooling (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backups (used by scripts/backup.sh on the VPS)
RESTIC_REPOSITORY=b2:ostazna-backups:/postgres
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Caddy / DNS
CF_API_TOKEN=

# Edge Function cron auth
CRON_SECRET=

# Monitoring
GRAFANA_PASSWORD=changeme
